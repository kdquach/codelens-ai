{
  "name": "codelens-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev --workspace=@codelens/server\" \"npm run dev --workspace=@codelens/web\"",
    "dev:server": "npm run dev --workspace=@codelens/server",
    "dev:web": "npm run dev --workspace=@codelens/web",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.2"
  }
}