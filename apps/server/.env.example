# Cổng dịch vụ Express API
PORT=4000

# MongoDB Atlas URI (Cơ sở dữ liệu chính)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codelens_db?retryWrites=true&w=majority

# Redis (Dùng cho BullMQ Queue & Worker)
REDIS_URL=redis://localhost:6379

# Google Gemini API Key (Gemini 2.5 Flash & text-embedding-004)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# GitHub Personal Access Token (Dùng để đọc Repository Blobs & Comment lên PR)
GITHUB_TOKEN=ghp_YourGitHubPersonalAccessTokenHere

# GitHub Webhook Secret (Xác thực chữ ký HMAC-SHA256 từ GitHub Webhooks)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# JWT & Mã hóa AES-256 (Sprint 5 - Task TS-20)
JWT_SECRET=your_jwt_secret_key_minimum_32_chars
ENCRYPTION_KEY=your_aes_256_encryption_secret_key

# GitHub OAuth App Credentials (Sprint 5 - UC07)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Địa chỉ Frontend & Webhook Base URL
CLIENT_URL=http://localhost:3000
WEBHOOK_BASE_URL=https://api.codelens.ai
